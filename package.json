{
  "name": "obsidian-stash-review",
  "version": "0.1.0",
  "private": true,
  "description": "A pull-request-style workspace for Git stashes in Obsidian.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node tests/package-smoke.mjs",
    "package": "node scripts/package-release.mjs",
    "preview": "vite --host 127.0.0.1",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:package && npm run test:e2e"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "latest",
    "typescript": "^5.7.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
